# --- Database -----------------------------------------------------------------
# Default (SRV) connection string. Convenient, but relies on a DNS SRV lookup
# (_mongodb._tcp.<host>) to discover the cluster nodes.
DATABASE_URL="mongodb+srv://<db_username>:<db_password>@peacock.gwe4u.mongodb.net/prod_db?retryWrites=true&w=majority&appName=peacock"

# Serverless DNS note (Vercel / AWS Lambda):
# On some serverless hosts the resolver appends an internal search domain
# (e.g. ".ec2.internal") to the SRV lookup, producing
#   _mongodb._tcp.peacock.gwe4u.mongodb.net.ec2.internal  -> "no record found"
# and every DB call fails with a PrismaClientInitializationError (DNS resolution).
# If that happens, use the NON-SRV "seedlist" string instead — it lists the
# shard hosts directly and skips the SRV lookup entirely. Get it from Atlas:
#   Connect -> Drivers -> pick an older Node.js driver version (<= 2.2.12).
# It looks like:
#   DATABASE_URL="mongodb://<user>:<pass>@peacock-shard-00-00.gwe4u.mongodb.net:27017,peacock-shard-00-01.gwe4u.mongodb.net:27017,peacock-shard-00-02.gwe4u.mongodb.net:27017/prod_db?ssl=true&replicaSet=atlas-xxxxxx-shard-0&authSource=admin&retryWrites=true&w=majority"
# Also confirm the Atlas cluster is not paused and Network Access allows 0.0.0.0/0.

JWT_SECRET="!@#dab86t678t68t8g867,"
SUPER_ADMIN_PASSWORD="1234567890"
SKIP_CACHE="true"
